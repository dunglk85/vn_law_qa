# --- Provider Selection (swap implementations without touching code) ---
VECTOR_STORE_TYPE=pgvector
LLM_TYPE=openai
EMBEDDINGS_TYPE=openai
RERANKER_TYPE=none
# cohere | cross_encoder | mmr | none
CACHE_TYPE=redis
RETRIEVER_TYPE=dense
QUERY_TRANSFORMER_TYPE=none
# none | hyde | decomposition | hyde_decomposition

# --- Model Names ---
LLM_MODEL=gpt-4o-mini
EMBEDDINGS_MODEL=text-embedding-3-small
RERANKER_MODEL=rerank-multilingual-v3.0

# --- RAG Tuning ---
RETRIEVAL_K=5
RRF_K=60
RERANKER_TOP_N=3
MMR_LAMBDA_MULT=0.5
CACHE_DISTANCE_THRESHOLD=0.98

# --- Connections ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
OPENAI_API_KEY=sk-your-openai-api-key-here

LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-key-here
LANGSMITH_PROJECT=cka

DATA_DIR=data

CO_API_KEY=your-cohere-api-key-here
REDIS_URL=redis://localhost:6379/0

# --- Index Parameters (pgvector) ---
INDEX_TYPE=hnsw
# hnsw | ivfflat

HNSW_M=16
HNSW_EF_CONSTRUCTION=64

IVFFLAT_LISTS=100
IVFFLAT_PROBES=10

# --- Auth ---
API_KEY=your-api-key-for-programmatic-access
JWT_SECRET=change-me-to-a-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
